# ==============================================================================
# PERC Response Service - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local or production environment.
# NEVER commit your actual .env file to version control.

# Database Connection (PostgreSQL / Supabase)
# For local host development: postgresql+psycopg://postgres:postgres_password@localhost:5432/perc_db
# For Docker Compose: postgresql+psycopg://postgres:postgres_password@postgres:5432/perc_db
DATABASE_URL=postgresql+psycopg://postgres:postgres_password@localhost:5432/perc_db

# Application Environment ('development' or 'production')
ENVIRONMENT=development

# Query Understanding Provider
# 'mock' -> Fast deterministic rule/dataset provider (default for CI and unit tests)
# 'llm'  -> Live LLM-based query understanding via Ollama Qwen3:8B
QUERY_UNDERSTANDING_PROVIDER=mock

# LLM Provider Configuration
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.0

# Ollama Service Configuration
# For local host development: http://localhost:11434
# For Docker Compose: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=180
