DATABASE_URL=postgresql+psycopg://postgres:<your-db-password>@localhost:5432/perc_db
KAFKA_BROKERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_USE_SSL=false
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

PORT=8000
ENVIRONMENT=development
INTERNAL_SERVICE_API_KEY=

LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=<your-groq-api-key>
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
LLM_TIMEOUT=30

META_ACCESS_TOKEN=
META_APP_SECRET=
WABA_ID=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=v26.0
WEBHOOK_VERIFY_TOKEN=perc_webhook_secret_token

KAFKA_CLIENT_ID=perc-response-service
KAFKA_GROUP_ID=perc-response-service-group
KAFKA_TOPIC_LEAD_EVENTS=perc.lead-events
KAFKA_TOPIC_ACTION_REQUIRED=perc.followup.action-required
KAFKA_TOPIC_MEETING_EVENTS=perc.meeting-events
KAFKA_TOPIC_RESPONSE_SENT=perc.response.sent
KAFKA_TOPIC_FOLLOWUP_SENT=perc.followup.sent
KAFKA_TOPIC_MEETING_CREATE_REQUESTED=perc.meeting.create-requested

REDIS_URL=redis://localhost:6379/0
